# Docker build context exclusions for PrescriptCheck

# Version control
.git/
.gitignore

# Node dependencies (installed in container)
node_modules/
backend/node_modules/
frontend/node_modules/

# Build artifacts
dist/
build/
coverage/

# Environment files (use Docker secrets or environment variables)
.env
.env.local
.env.*.local

# Logs
logs/
*.log

# Development config files
.eslintrc*
.prettierrc*
.editorconfig
jest.config.js

# Documentation
docs/
*.md

# Development tools
.vscode/
.idea/
*.swp
*.bak

# Test files
tests/
**/*.test.js
**/*.spec.js

# OS files
.DS_Store
Thumbs.db
