# PrescriptCheck Test Environment Configuration
# Used for automated tests – NOT for production use

NODE_ENV=test
PORT=3001

# Test Database (separate from development/production)
MONGODB_URI=mongodb://localhost:27017/prescriptcheck_test
TEST_MONGODB_URI=mongodb://localhost:27017/prescriptcheck_test

# Test JWT Secret (use a different secret from production)
JWT_SECRET=test-jwt-secret-at-least-32-chars-long-for-tests
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Test Encryption Key
ENCRYPTION_KEY=test-encryption-key-for-unit-tests-only-32chars

# Test Audit HMAC Secret
AUDIT_SECRET=test-audit-hmac-secret-for-tests

# Logging
LOG_LEVEL=error

# Disable 2FA in tests
ENABLE_2FA=false

# Rate limiting (relaxed for tests)
RATE_LIMIT_MAX=1000

# Allowed origins for test
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
