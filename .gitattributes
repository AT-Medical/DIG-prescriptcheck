# PrescriptCheck .gitattributes
# Ensure consistent line endings across platforms

# Default: normalize to LF
* text=auto eol=lf

# Explicitly text files
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.env text eol=lf
*.conf text eol=lf
Makefile text eol=lf

# Shell scripts must use LF
*.sh text eol=lf

# Binary files – do not modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary
*.tgz binary

# Large files via Git LFS (if configured)
# docs/manuals/*.pdf filter=lfs diff=lfs merge=lfs -text
